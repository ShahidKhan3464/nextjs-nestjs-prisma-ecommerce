generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               Int               @id(map: "PK_a3ffb1c0c8416b9fc6f907b7433") @default(autoincrement())
  fullName         String            @db.VarChar(30)
  phoneNumber      String?           @unique(map: "UQ_users_phone_number") @db.VarChar
  email            String            @unique(map: "UQ_97672ac88f789774dd47f7c8be3") @db.VarChar
  password         String            @db.VarChar
  isBlocked        Boolean           @default(false)
  createdAt        DateTime          @default(now()) @db.Timestamp(6)
  updatedAt        DateTime          @default(now()) @updatedAt @db.Timestamp(6)
  deletedAt        DateTime?         @db.Timestamp(6)
  orders           Order[]
  reviews          Review[]
  files            UserFile[]
  userRoles        UserRole[]
  cartItems        CartItem[]
  addresses        UserAddress[]
  wishlistItems    WishlistItem[]
  notifications    Notification[]
  sellerProfile    SellerProfile?
  checkoutSessions CheckoutSession[]
  refreshTokens    RefreshToken[]

  @@index([deletedAt])
  @@map("users")
}

model UserAddress {
  id                 Int      @id @default(autoincrement())
  userId             Int
  label              String?  @db.VarChar(100)
  fullName           String   @db.VarChar(100)
  line1              String   @db.VarChar(255)
  line2              String?  @db.VarChar(255)
  city               String   @db.VarChar(100)
  region             String   @db.VarChar(100)
  postalCode         String   @db.VarChar(20)
  country            String   @db.VarChar(100)
  phone              String?  @db.VarChar(30)
  isDefaultShipping  Boolean  @default(false)
  isDefaultBilling   Boolean  @default(false)
  createdAt          DateTime @default(now()) @db.Timestamp(6)
  updatedAt          DateTime @default(now()) @updatedAt @db.Timestamp(6)
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId])
  @@index([userId, isDefaultShipping])
  @@index([userId, isDefaultBilling])
  @@map("user_addresses")
}

model RefreshToken {
  id              Int       @id @default(autoincrement())
  userId          Int
  tokenHash       String    @unique @db.VarChar(128)
  familyId        String    @db.VarChar(64)
  expiresAt       DateTime  @db.Timestamp(6)
  revokedAt       DateTime? @db.Timestamp(6)
  replacedByHash  String?   @db.VarChar(128)
  createdAt       DateTime  @default(now()) @db.Timestamp(6)
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model UserRole {
  userId     Int
  role       user_role_name_enum
  assignedAt DateTime            @default(now()) @db.Timestamp(6)
  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_user_roles_user_id")

  @@id([userId, role])
  @@index([role], map: "IDX_user_roles_role")
  @@map("user_roles")
}

model SellerProfile {
  id                 Int                        @id(map: "PK_seller_profiles") @default(autoincrement())
  userId             Int                        @unique(map: "UQ_seller_profiles_user_id")
  businessName       String                     @db.VarChar(255)
  businessEmail      String                     @unique(map: "UQ_seller_profiles_business_email") @db.VarChar(255)
  businessPhone      String                     @db.VarChar(30)
  taxNumber          String?                    @db.VarChar(50)
  registrationNumber String?                    @db.VarChar(50)
  status             seller_profile_status_enum @default(PENDING)
  approvedAt         DateTime?                  @db.Timestamp(6)
  rejectedReason     String?
  createdAt          DateTime                   @default(now()) @db.Timestamp(6)
  updatedAt          DateTime                   @default(now()) @updatedAt @db.Timestamp(6)
  deletedAt          DateTime?                  @db.Timestamp(6)
  store              Store?
  sellerDocuments    SellerDocument[]
  user               User                       @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_seller_profiles_user_id")

  @@index([deletedAt])
  @@index([businessName])
  @@index([status], map: "IDX_seller_profiles_status")
  @@map("seller_profiles")
}

model Store {
  id               Int               @id(map: "PK_stores") @default(autoincrement())
  sellerProfileId  Int               @unique(map: "UQ_stores_seller_profile_id")
  name             String            @db.VarChar(255)
  slug             String            @unique(map: "UQ_stores_slug") @db.VarChar(255)
  description      String?
  address          String            @db.VarChar(255)
  city             String            @db.VarChar(100)
  postalCode       String            @db.VarChar(20)
  country          String            @db.VarChar(100)
  status           store_status_enum @default(ACTIVE)
  verifiedAt       DateTime?         @db.Timestamp(6)
  createdAt        DateTime          @default(now()) @db.Timestamp(6)
  suspensionReason String?
  suspendedAt      DateTime?
  updatedAt        DateTime          @default(now()) @updatedAt @db.Timestamp(6)
  deletedAt        DateTime?         @db.Timestamp(6)
  orders           Order[]
  products         Product[]
  files            StoreFile[]
  sellerProfile    SellerProfile     @relation(fields: [sellerProfileId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_stores_seller_profile_id")

  @@index([deletedAt])
  @@index([status], map: "IDX_stores_status")
  @@map("stores")
}

model Category {
  id          Int       @id(map: "PK_24dbc6126a28ff948da33e97d3b") @default(autoincrement())
  name        String    @db.VarChar(255)
  description String?
  createdAt   DateTime  @default(now()) @db.Timestamp(6)
  updatedAt   DateTime  @default(now()) @updatedAt @db.Timestamp(6)
  deletedAt   DateTime? @db.Timestamp(6)
  products    Product[]

  @@unique([name])
  @@index([deletedAt])
  @@map("categories")
}

model Product {
  id            Int                  @id(map: "PK_0806c755e0aca124e67c0cf6d7d") @default(autoincrement())
  name          String               @db.VarChar(255)
  slug          String               @unique(map: "UQ_464f927ae360106b783ed0b4106") @db.VarChar(255)
  description   String?
  basePrice     Decimal              @default(0) @db.Decimal(10, 2)
  status        products_status_enum @default(ACTIVE)
  publishedAt   DateTime?            @db.Timestamp(6)
  createdAt     DateTime             @default(now()) @db.Timestamp(6)
  updatedAt     DateTime             @default(now()) @updatedAt @db.Timestamp(6)
  deletedAt     DateTime?            @db.Timestamp(6)
  categoryId    Int
  storeId       Int
  reviews       Review[]
  files         ProductFile[]
  wishlistItems WishlistItem[]
  variants      ProductVariant[]
  store         Store                @relation(fields: [storeId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "FK_products_store_id")
  category      Category             @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "FK_ff56834e735fa78a15d0cf21926")

  @@index([deletedAt])
  @@index([name], map: "IDX_products_name")
  @@index([status], map: "IDX_products_status")
  @@index([categoryId], map: "IDX_ff56834e735fa78a15d0cf2192")
  @@index([storeId], map: "IDX_products_store_id")
  @@index([publishedAt], map: "IDX_products_published_at")
  @@map("products")
}

model ProductVariant {
  id                   Int                   @id(map: "PK_281e3f2c55652d6a22c0aa59fd7") @default(autoincrement())
  size                 String                @db.VarChar(255)
  color                String                @db.VarChar(255)
  sku                  String                @unique(map: "UQ_46f236f21640f9da218a063a866") @db.VarChar
  stockQuantity        Int
  price                Decimal               @db.Decimal(10, 2)
  createdAt            DateTime              @default(now()) @db.Timestamp(6)
  updatedAt            DateTime              @default(now()) @updatedAt @db.Timestamp(6)
  productId            Int
  cartItems            CartItem[]
  orderItems           OrderItem[]
  checkoutSessionItems CheckoutSessionItem[]
  product              Product               @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_f515690c571a03400a9876600b5")

  @@unique([productId, color, size], map: "UQ_product_variants_product_id_color_size")
  @@map("product_variants")
}

model StoredFile {
  id              Int              @id(map: "PK_files") @default(autoincrement())
  originalName    String           @db.VarChar(255)
  storedName      String           @db.VarChar(255)
  mimeType        String           @db.VarChar(100)
  extension       String           @db.VarChar(20)
  fileSize        Int
  storageKey      String           @unique @db.VarChar(512)
  urlPath         String           @db.VarChar(512)
  createdAt       DateTime         @default(now()) @db.Timestamp(6)
  userFiles       UserFile[]
  storeFiles      StoreFile[]
  productFiles    ProductFile[]
  sellerDocuments SellerDocument[]

  @@map("stored_files")
}

model ProductFile {
  id        Int                    @id @default(autoincrement())
  productId Int
  fileId    Int
  type      product_file_type_enum
  sortOrder Int                    @default(0)
  product   Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  file      StoredFile             @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@unique([productId, fileId])
  @@index([fileId])
  @@index([type])
  @@map("product_files")
}

model UserFile {
  id        Int                 @id @default(autoincrement())
  userId    Int
  fileId    Int
  type      user_file_type_enum
  sortOrder Int                 @default(0)
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  file      StoredFile          @relation(fields: [fileId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, fileId])
  @@index([fileId])
  @@index([type])
  @@map("user_files")
}

model StoreFile {
  id        Int                  @id @default(autoincrement())
  storeId   Int
  fileId    Int
  type      store_file_type_enum
  sortOrder Int                  @default(0)
  store     Store                @relation(fields: [storeId], references: [id], onDelete: Cascade)
  file      StoredFile           @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@unique([storeId, fileId])
  @@index([fileId])
  @@index([type])
  @@map("store_files")
}

model SellerDocument {
  id              Int                       @id @default(autoincrement())
  sellerProfileId Int
  fileId          Int
  type            seller_document_type_enum
  sellerProfile   SellerProfile             @relation(fields: [sellerProfileId], references: [id], onDelete: Cascade)
  file            StoredFile                @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@unique([sellerProfileId, fileId])
  @@index([fileId])
  @@index([type])
  @@map("seller_documents")
}

model CartItem {
  id               Int            @id(map: "PK_6fccf5ec03c172d27a28a82928b") @default(autoincrement())
  userId           Int
  productVariantId Int
  quantity         Int            @default(1)
  createdAt        DateTime       @default(now()) @db.Timestamp(6)
  updatedAt        DateTime       @default(now()) @updatedAt @db.Timestamp(6)
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_84e765378a5f03ad9900df3a9ba")
  variant          ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_98ba4bbf6e3611d2062b898f5c1")

  @@unique([userId, productVariantId], map: "UQ_029e3499726b1681378523174da")
  @@map("cart_items")
}

model WishlistItem {
  id        Int      @id(map: "PK_0bd52924a97cda208ed2a07bd69") @default(autoincrement())
  userId    Int
  productId Int
  createdAt DateTime @default(now()) @db.Timestamp(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_3167e7490f12ed329a36703d980")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_485ece8ab9b569d1c560144aa25")

  @@unique([userId, productId], map: "UQ_d461b3ed3990144aa6d5c45083b")
  @@map("wishlist_items")
}

model Order {
  id                 Int                @id(map: "PK_710e2d4957aa5878dfe94e4ac2f") @default(autoincrement())
  userId             Int
  storeId            Int
  orderNumber        String             @unique(map: "UQ_59b0c3b34ea0fa5562342f24143") @db.VarChar(64)
  status             orders_status_enum @default(PENDING)
  totalAmount        Decimal            @db.Decimal(10, 2)
  subtotal           Decimal            @default(0) @db.Decimal(10, 2)
  tax                Decimal            @default(0) @db.Decimal(10, 2)
  shippingAddress    String
  cancellationReason String?
  shippedAt          DateTime?          @db.Timestamp(6)
  deliveredAt        DateTime?          @db.Timestamp(6)
  cancelledAt        DateTime?          @db.Timestamp(6)
  createdAt          DateTime           @default(now()) @db.Timestamp(6)
  updatedAt          DateTime           @default(now()) @updatedAt @db.Timestamp(6)
  payment            Payment?
  items              OrderItem[]
  store              Store              @relation(fields: [storeId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "FK_orders_store_id")
  user               User               @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "FK_151b79a83ba240b0cb31b2302d1")

  @@index([userId], map: "IDX_orders_user_id")
  @@index([status], map: "IDX_orders_status")
  @@index([storeId], map: "IDX_orders_store_id")
  @@map("orders")
}

model OrderItem {
  id              Int            @id(map: "PK_005269d8574e6fac0493715c308") @default(autoincrement())
  orderId         Int
  variantId       Int
  quantity        Int
  productName     String         @db.VarChar(255)
  variantSku      String         @db.VarChar(100)
  variantColor    String         @db.VarChar(255)
  variantSize     String         @db.VarChar(255)
  priceAtPurchase Decimal        @db.Decimal(10, 2)
  productImageUrl String?        @db.VarChar(512)
  variant         ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "FK_516736b9807228bb17b2d0a3e2a")
  order           Order          @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_f1d359a55923bb45b057fbdab0d")

  @@unique([orderId, variantId], map: "UQ_order_items_order_id_variant_id")
  @@map("order_items")
}

model Payment {
  id               Int                   @id(map: "PK_payments") @default(autoincrement())
  orderId          Int                   @unique(map: "UQ_payments_order_id")
  provider         payment_provider_enum @default(STRIPE)
  transactionId    String?               @db.VarChar(255)
  failureReason    String?               @db.VarChar(255)
  amount           Decimal               @db.Decimal(10, 2)
  currency         String                @default("usd") @db.VarChar(3)
  status           payment_status_enum   @default(PENDING)
  methodSummary    String?               @db.VarChar(255)
  paidAt           DateTime?             @db.Timestamp(6)
  refundedAmount   Decimal               @default(0) @db.Decimal(10, 2)
  refundReason     String?               @db.VarChar(255)
  refundedAt       DateTime?             @db.Timestamp(6)
  externalRefundId String?               @db.VarChar(255)
  createdAt        DateTime              @default(now()) @db.Timestamp(6)
  updatedAt        DateTime              @default(now()) @updatedAt @db.Timestamp(6)
  order            Order                 @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_payments_order_id")

  @@index([transactionId], map: "IDX_payments_transaction_id")
  @@index([status], map: "IDX_payments_status")
  @@index([provider], map: "IDX_payments_provider")
  @@map("payments")
}

model CheckoutSession {
  id                    Int                          @id(map: "PK_5730b2bbc190203a94941d82bd1") @default(autoincrement())
  userId                Int
  status                checkout_session_status_enum @default(PENDING)
  totalAmount           Decimal                      @db.Decimal(10, 2)
  subtotal              Decimal                      @default(0) @db.Decimal(10, 2)
  tax                   Decimal                      @default(0) @db.Decimal(10, 2)
  shippingAddress       String
  stripePaymentIntentId String                       @db.VarChar(255)
  createdAt             DateTime                     @default(now()) @db.Timestamp(6)
  updatedAt             DateTime                     @default(now()) @updatedAt @db.Timestamp(6)
  items                 CheckoutSessionItem[]
  user                  User                         @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_03c03fa217eec30f71d2762f44e")

  @@index([userId], map: "IDX_checkout_sessions_user_id")
  @@index([status], map: "IDX_checkout_sessions_status")
  @@index([stripePaymentIntentId], map: "IDX_checkout_sessions_stripe_payment_intent_id")
  @@map("checkout_sessions")
}

model CheckoutSessionItem {
  id                Int             @id(map: "PK_4bc14bdd64e6077b3c75fcf2cfe") @default(autoincrement())
  checkoutSessionId Int
  variantId         Int
  quantity          Int
  priceAtPurchase   Decimal         @db.Decimal(10, 2)
  variant           ProductVariant  @relation(fields: [variantId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "FK_57044fc85b65fe42b4cfcaf05c2")
  session           CheckoutSession @relation(fields: [checkoutSessionId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_ec11f9a5ff93785bf57e652bef3")

  @@unique([checkoutSessionId, variantId], map: "UQ_checkout_session_items_checkout_session_id_variant_id")
  @@map("checkout_session_items")
}

model Review {
  id        Int      @id(map: "PK_reviews") @default(autoincrement())
  userId    Int
  productId Int
  rating    Int
  title     String?  @db.VarChar(255)
  comment   String?
  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamp(6)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_reviews_product_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_reviews_user_id")

  @@unique([userId, productId], map: "UQ_reviews_user_id_product_id")
  @@index([productId], map: "IDX_reviews_product_id")
  @@map("reviews")
}

model Notification {
  id        Int                    @id(map: "PK_notifications") @default(autoincrement())
  userId    Int
  type      notification_type_enum
  title     String                 @db.VarChar(255)
  message   String
  readAt    DateTime?              @db.Timestamp(6)
  createdAt DateTime               @default(now()) @db.Timestamp(6)
  user      User                   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_notifications_user_id")

  @@index([userId], map: "IDX_notifications_user_id")
  @@index([userId, readAt], map: "IDX_notifications_user_id_is_read")
  @@map("notifications")
}

enum store_file_type_enum {
  LOGO
  BANNER
}

enum seller_document_type_enum {
  BUSINESS_LICENSE
  TAX_DOCUMENT
}

enum user_role_name_enum {
  BUYER
  SELLER
  SUPER_ADMIN
}

enum seller_profile_status_enum {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum store_status_enum {
  ACTIVE
  SUSPENDED
}

enum payment_provider_enum {
  STRIPE
  COD
  OTHER
}

enum payment_status_enum {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum checkout_session_status_enum {
  PENDING
  COMPLETED
  CANCELLED
  EXPIRED
}

enum notification_type_enum {
  ORDER_CREATED
  ORDER_SHIPPED
  ORDER_DELIVERED
  ORDER_CANCELLED
  SELLER_APPROVED
  SELLER_REJECTED
  PRODUCT_APPROVED
  PRODUCT_REJECTED
  STORE_ANNOUNCEMENT
  PRODUCT_BACK_IN_STOCK
  SYSTEM
}

enum orders_status_enum {
  PENDING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum products_status_enum {
  ACTIVE
  DRAFT
  ARCHIVED
}

enum product_file_type_enum {
  THUMBNAIL
  GALLERY
  MANUAL
}

enum user_file_type_enum {
  AVATAR
  DOCUMENT
  COVER
}
