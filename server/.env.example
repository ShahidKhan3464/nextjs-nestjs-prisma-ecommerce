# Application
NODE_ENV=development
PORT=3001
API_VERSION=v1
FRONTEND_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://postgres:your_database_password@localhost:5432/ecommerce

# Auth
JWT_SECRET=replace_with_a_long_random_secret
JWT_ACCESS_TOKEN_TTL=2d
JWT_REFRESH_TOKEN_TTL=7d

# Stripe
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
# Required in production (optional in development)
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# Swagger (forced off in production unless explicitly true)
SWAGGER_ENABLED=false

# Mail
MAIL_HOST=smtp.example.com
MAIL_PORT=2525
MAIL_SECURE=false
SMTP_USERNAME=your_smtp_username
SMTP_PASSWORD=your_smtp_password

# Optional seed admin (used by seeders only)
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Admin User
ADMIN_PHONE=5555555555
ADMIN_PASSWORD=change_me_in_production
SEED_DEMO_DATA=false
