<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Order Status Update</title>
  </head>
  <body
    style="font-family: Arial, Helvetica, sans-serif; line-height: 1.6; color: #1a1a1a; max-width: 600px; margin: 0 auto; padding: 20px; background: #f5f5f4;"
  >
    <div style="background: #ffffff; padding: 32px; border-radius: 12px; border: 1px solid #e7e5e4;">
      <p style="margin: 0 0 8px; font-size: 12px; letter-spacing: 0.08em; text-transform: uppercase; color: #78716c;">
        Atelier Commerce
      </p>
      <h1 style="margin: 0 0 16px; font-size: 24px; font-weight: 600;">
        Order status updated
      </h1>
      <p style="margin: 0 0 24px; color: #57534e;">
        Hi <%= typeof name !== 'undefined' && name ? name : 'there' %>, your order <strong><%= orderNumber %></strong> is now <strong><%= statusLabel %></strong>.
      </p>

      <div style="background: #fafaf9; border: 1px solid #e7e5e4; border-radius: 8px; padding: 20px; margin-bottom: 24px;">
        <p style="margin: 0 0 8px; font-size: 13px; color: #78716c;">Order total</p>
        <p style="margin: 0 0 16px; font-size: 18px; font-weight: 600;">$<%= total %></p>
        <p style="margin: 0 0 8px; font-size: 13px; color: #78716c;">Payment</p>
        <p style="margin: 0; font-size: 14px;"><%= paymentMethodSummary %></p>
      </div>

      <p style="margin: 0; color: #57534e; font-size: 14px;">
        You can view full order details anytime in your account. Thank you for shopping with us.
      </p>
    </div>
  </body>
</html>
